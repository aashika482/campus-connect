# Copy this to .env and fill in your values
# NEVER commit .env to git

# Backend API URL
# Local dev: http://localhost:8000
# Production: https://your-backend.up.railway.app  (or your Render URL)
VITE_API_URL=http://localhost:8000

# Poster uploads need no frontend config: they're signed by the backend
# (see CLOUDINARY_* in backend/.env.example). Never put Cloudinary keys here —
# every VITE_ variable is visible to anyone who opens the site.
