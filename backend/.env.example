# Copy this to .env and fill in your values
# NEVER commit .env to git

# Neon PostgreSQL — get this from your Neon dashboard > Connection string
DATABASE_URL=postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this

# Optional
DEBUG=False

# Frontend origins allowed to call the API (comma-separated, no trailing slash).
# Defaults to http://localhost:5173 for local dev. In production, set the deployed URL:
# CORS_ORIGINS=https://campulse.vercel.app

# Cloudinary — Dashboard > Settings > API Keys. Enables signed poster uploads.
# Leave empty to disable uploads (the poster field then takes a pasted image URL).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to False only when DATABASE_URL points at a local Postgres without SSL (dev / tests)
# DATABASE_SSL=True

# College email domains allowed to sign up (comma-separated, no "@").
# The domain decides the account type: student or faculty.
# STUDENT_EMAIL_DOMAINS=muj.manipal.edu
# FACULTY_EMAIL_DOMAINS=jaipur.manipal.edu

# Most active editors a club can have (it always has one owner). The DSW can't approve past it.
# MAX_EDITORS_PER_CLUB=5

# Demo data only (python -m app.db.demo wipes everything except clubs). NEVER set in production.
# DEMO_MODE=true
# DEMO_PASSWORD=pick-a-demo-password
